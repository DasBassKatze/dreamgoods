# Скопируйте в .env и при необходимости поменяйте. Файл .env никому не отправляйте: в нём пароли.
# Имя базы и пользователя «studio» — внутренние, остались с первой версии (менять не нужно: там ваши данные)
DATABASE_URL=postgresql+psycopg://studio:studio@127.0.0.1:5432/studio
POSTGRES_PASSWORD=studio

# Хранилище файлов: local — папка на диске (сейчас), s3 — облако (релиз)
STORAGE=local
STORAGE_DIR=
# Для релиза (пример — Yandex Object Storage); перенос файлов: python run_dreamgoods.py --upload-to-s3
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=dreamgoods
S3_REGION=ru-central1

# Ключ Polza можно указать здесь или в настройках интерфейса
POLZA_API_KEY=
DREAMGOODS_PORT=8765
# Сервер (docker compose --profile server): на каком адресе и порту сервера открыть сайт.
# 0.0.0.0 — на всех адресах сервера (например, http://192.168.94.107:8090); 127.0.0.1 — только локально (за nginx)
DREAMGOODS_BIND=0.0.0.0
DREAMGOODS_PUBLIC_PORT=8090
# Сколько заданий выполнять одновременно при первом запуске (дальше меняется в админ-панели, до 12)
DREAMGOODS_WORKERS=4
# Первый мастер-аккаунт (создаётся при первом запуске, если мастера с паролем ещё нет).
# Потом пароль меняется на сайте: «Учётная запись» → «Сменить пароль».
DREAMGOODS_ADMIN_EMAIL=admin
DREAMGOODS_ADMIN_PASSWORD=admin
